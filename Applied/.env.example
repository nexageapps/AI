# Copy to Applied/.env (git-ignored) and fill in. Every variable is optional: lessons run OFFLINE without keys.

# LIVE mode for Advanced / Agents / Applied lessons
ANTHROPIC_API_KEY=

# Optional: use a cheaper model while learning (default is set in agentkit/llm.py)
# AGENTKIT_MODEL=

# Optional: force offline replay even when a key is present
# AGENTKIT_OFFLINE=1

# Only for the managed vector-DB variant in AP10
PINECONE_API_KEY=
